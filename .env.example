# .env 예시 — 복사해서 .env 로 쓰고 환경에 맞게 고친다.
#   cp .env.example .env
# config.py 가 여기 값을 읽어 상수로 노출한다 (override=True 라 OS 환경변수보다 우선).

# ── 서버
HOST=0.0.0.0
PORT=19700

# ── ffmpeg — ffmpeg/ffprobe 가 들어있는 디렉토리
#    NVDEC/NVENC 를 쓰므로 nvenc 가 빌드된 바이너리여야 한다 (ffmpeg -encoders | grep nvenc)
FFMPEG_DIR="/usr/local/ffmpeg-gpu"
GPU_NUM=0

# ── 스토리지
#    INPUT_DATA_DIR  원본과 범퍼. 범퍼는 종목별 하위 폴더 (예: {INPUT_DATA_DIR}/baseball/)
#    OUTPUT_DATA_DIR 결과물. {v_id}/{v_id}_{c_id}.mp4 로 쌓이고 중간 조각은 work_{c_id}/ 에 만든다
INPUT_DATA_DIR="data/input"
OUTPUT_DATA_DIR="data/output"

# ── S3 업로드 — 비워두면 올리지 않고 로컬에만 남긴다.
#    결과물은 {S3URL}/{v_id}/{v_id}_{c_id}.mp4, 구간 목록은 같은 이름의 .json 으로 올라간다.
#    자격증명은 boto3 기본 체인(~/.aws, IAM 역할, AWS_* 환경변수)을 그대로 쓴다.
S3URL="s3://<s3 bucket>/result"
